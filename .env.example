# 知行旅行规划助手 — 环境配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（可选，默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# HuggingFace 镜像（国内用户推荐，避免被墙）
HF_ENDPOINT=https://hf-mirror.com

# 运行环境：test | dev | prod
#   test = 沙盒模式，Mock LLM，¥0 成本跑测试
#   dev  = 开发模式，调试日志，真实 API
#   prod = 生产模式，降级链 + 最少日志
APP_ENV=dev
