# 知行旅行规划助手 — 环境配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（可选，默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# HuggingFace 镜像（国内用户推荐，避免被墙）
HF_ENDPOINT=https://hf-mirror.com

# 数据管道：主动定时爬取，保持知识库新鲜
# PIPELINE_ENABLED=true → 启用后台爬虫
# PIPELINE_HOT_INTERVAL=4 → 热门城市每 N 小时刷新
# PIPELINE_WARM_INTERVAL=24 → 本地攻略城市每 N 小时刷新
# PIPELINE_HOT_COUNT=5 → 热门城市取 Top-N
# PIPELINE_QUERIES_PER_CITY=4 → 每城市每次搜索 query 数
PIPELINE_ENABLED=true
PIPELINE_HOT_INTERVAL=4
PIPELINE_WARM_INTERVAL=24
PIPELINE_HOT_COUNT=5
PIPELINE_QUERIES_PER_CITY=4

# 运行环境：test | dev | prod
#   test = 沙盒模式，Mock LLM，¥0 成本跑测试
#   dev  = 开发模式，调试日志，真实 API
#   prod = 生产模式，降级链 + 最少日志
APP_ENV=dev
